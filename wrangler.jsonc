{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayflow-english",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sayflow-sync",
      "database_id": "258180a9-16c6-4260-ab2c-1d5c893fc462",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": false
}
